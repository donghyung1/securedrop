AWS_REGION=ap-northeast-2
# Local development only. Omit on EC2 to use its IAM Role.
# AWS_PROFILE=lab
S3_BUCKET=securedrop-cloud-demo
# Set to your public HTTPS origin behind a reverse proxy or CloudFront.
# PUBLIC_BASE_URL=https://securedrop.example.com
MAX_FILE_MB=20
SCAN_FILE_MAX_MB=5
DEFAULT_EXPIRES_SEC=600
MAX_EXPIRES_SEC=3600
SANITIZE_TTL_SEC=600
SANITIZE_MEMORY_MB=100
# Generate your own secret; never commit .env.
PLUGIN_API_KEY=
ALLOWED_ORIGINS=["http://localhost:5500","http://localhost:8000","http://127.0.0.1:5500","http://127.0.0.1:8000"]
DATABASE_PATH=data/securedrop.db
