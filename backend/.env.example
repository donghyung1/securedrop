APP_ENV=local
AWS_REGION=ap-northeast-2
# Local developer profile only. Lambda uses its execution role.
# AWS_PROFILE=lab
FILES_BUCKET=securedrop-files-your-account
TABLE_TRANSFERS=sd_transfers
TABLE_SESSIONS=sd_sessions
TABLE_EVENTS=sd_events
TABLE_ADMINS=sd_admins
TABLE_ADMIN_SESSIONS=sd_admin_sessions
PUBLIC_BASE_URL=https://your-distribution.cloudfront.net
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:8000,https://your-distribution.cloudfront.net
MAX_FILE_MB=20
SCAN_FILE_MAX_MB=4
MAX_FILES_PER_TRANSFER=5
DEFAULT_EXPIRES_SEC=600
MAX_EXPIRES_SEC=3600
UPLOAD_URL_TTL_SEC=300
DOWNLOAD_URL_TTL_SEC=300
SESSION_TTL_SEC=600
ADMIN_SESSION_TTL_SEC=28800
ADMIN_LOGIN_MAX_FAILS=5
ADMIN_LOGIN_LOCK_SEC=900
